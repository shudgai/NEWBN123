<script>
async function manualClose(symbol, slot) {
  if (!confirm(`確定要手動平倉 ${symbol} [${slot}] 嗎?`)) return;
  try {
    const res = await fetch(`/api/close/${symbol}/${slot}`, { method: 'POST' });
    const result = await res.json();
    if (!result.ok) {
      alert(result.message || '平倉失敗');
    }
  } catch (e) {
    alert('平倉請求失敗: ' + e);
  } finally {
    refresh();
    refreshTrades();
  }
}

async function manualOpen(symbol, side) {
  if (!confirm(`確定要手動開${side === 'LONG' ? '多' : '空'} ${symbol} 嗎?`)) return;
  try {
    const res = await fetch(`/api/open/${symbol}/${side}`, { method: 'POST' });
    const result = await res.json();
    if (!result.ok) {
      alert(result.message || '開倉失敗');
    }
  } catch (e) {
    alert('開倉請求失敗: ' + e);
  } finally {
    refresh();
    refreshTrades();
  }
}

async function toggleTrading(currentlyEnabled) {
  const action = currentlyEnabled ? 'pause' : 'resume';
  const msg = currentlyEnabled
    ? '確定要停止交易嗎?不會再開新倉,但現有倉位仍會照常止損/移動停利。'
    : '確定要恢復交易嗎?';
  if (!confirm(msg)) return;
  try {
    await fetch(`/api/trading/${action}`, { method: 'POST' });
  } catch (e) {
    alert('操作失敗: ' + e);
  } finally {
    refresh();
  }
}

async function refresh() {
  try {
    const res = await fetch('/api/status');
    const s = await res.json();
    const envLabel = s.paper_trading ? '紙交易 Paper Trading' : (s.testnet ? '測試網 Testnet' : '正式環境 LIVE');
    const modeLabel = s.paper_trading ? '模擬損益(不會真的下單)' : (s.dry_run ? 'DRY RUN' : '真實下單');
    const rpnl = s.realized_pnl;
    const rpnlClass = rpnl > 0 ? 'pnl-pos' : (rpnl < 0 ? 'pnl-neg' : '');

    const tradingEnabled = s.trading_enabled !== false;
    document.getElementById('summary').innerHTML = `
      <div class="card"><div class="label">環境</div><div class="value">${envLabel}</div></div>
      <div class="card"><div class="label">下單模式</div><div class="value"><span class="badge ${(s.paper_trading || s.dry_run) ? 'off' : 'on'}">${modeLabel}</span></div></div>
      <div class="card"><div class="label">運行狀態</div><div class="value"><span class="badge ${s.running ? 'on' : 'off'}">${s.running ? '運行中' : '已停止'}</span></div></div>
      <div class="card">
        <div class="label">交易開關</div>
        <div class="value" style="display:flex; align-items:center; gap:.6rem;">
          <span class="badge ${tradingEnabled ? 'on' : 'off'}">${tradingEnabled ? '交易中' : '已暫停'}</span>
          <button class="trading-toggle-btn" onclick="toggleTrading(${tradingEnabled})">${tradingEnabled ? '停止交易' : '恢復交易'}</button>
        </div>
