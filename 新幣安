            </div>
            <div class="grid">
              <div class="card"><div class="label">方向/數量</div><div class="value side-${pos.side || 'NONE'}">${pos.side || 'NONE'} ${pos.quantity ?? ''}</div></div>
              <div class="card"><div class="label">進場價</div><div class="value">${pos.entry_price ?? '-'}</div></div>
              <div class="card"><div class="label">投入本金 (USDT)</div><div class="value">${marginText}</div></div>
              <div class="card"><div class="label">名目價值 (USDT)</div><div class="value">${notionalText}</div></div>
              <div class="card"><div class="label">未實現損益</div><div class="value ${pnlClass}">${pnlText}</div></div>
              <div class="card"><div class="label">最後訊號</div><div class="value">${slotData.last_signal ?? '-'}</div></div>
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="symbol-section">
          <div class="symbol-header">
            <h2>${sym} <span class="symbol-price">${market.price ?? '-'}</span></h2>
          </div>
          ${slotBlocks}
          ${errHtml}
        </div>
      `;
    }).join('');

    document.getElementById('updated').textContent = '最後更新: ' + (s.last_update ?? '-');
  } catch (e) {
    document.getElementById('updated').textContent = '無法連線至機器人狀態 API: ' + e;
  }
}

async function refreshTrades() {
  const wrap = document.getElementById('tradesWrap');
  try {
    const res = await fetch('/api/trades');
    const trades = await res.json();
    if (!trades.length) {
      wrap.innerHTML = `<div class="empty-note">目前還沒有已平倉的交易紀錄。</div>`;
      return;
    }
    const sorted = [...trades].sort((a, b) => (a.exit_time < b.exit_time ? 1 : -1));
    const shown = sorted.slice(0, 200);
    const rows = shown.map(t => {
      const pnlClass = t.pnl > 0 ? 'pnl-pos' : (t.pnl < 0 ? 'pnl-neg' : '');
      const amount = t.entry_price * t.quantity;
      return `
        <tr>
          <td>${t.symbol}</td>
          <td class="side-${t.side}">${t.side}</td>
          <td>${(t.entry_time || '').replace('T', ' ').slice(0, 19)}</td>
          <td>${(t.exit_time || '').replace('T', ' ').slice(0, 19)}</td>
          <td>${t.entry_price}</td>
          <td>${t.exit_price}</td>
          <td>${t.quantity}</td>
          <td>${amount.toFixed(2)}</td>
          <td class="${pnlClass}">${t.pnl.toFixed(4)}</td>
          <td>${t.fee.toFixed(4)}</td>
          <td>${t.reason}</td>
        </tr>
      `;
    }).join('');
    const note = trades.length > shown.length
      ? `<div class="empty-note">只顯示最近 ${shown.length} 筆(共 ${trades.length} 筆),完整紀錄請下載 CSV。</div>` : '';
    wrap.innerHTML = `
      <table class="trades">
        <thead><tr>
          <th>幣種</th><th>方向</th><th>進場時間 (UTC)</th><th>出場時間 (UTC)</th>
          <th>進場價</th><th>出場價</th><th>數量</th><th>金額 (USDT)</th><th>損益 (USDT)</th><th>手續費 (USDT)</th><th>原因</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>
      ${note}
    `;
  } catch (e) {
    wrap.innerHTML = `<div class="empty-note">無法載入交易紀錄: ${e}</div>`;
  }
}

refresh();
refreshTrades();
setInterval(refresh, 3000);
setInterval(refreshTrades, 5000);
</script>
</body>
</html>
"""


def create_app(bot: "BinanceFuturesBot") -> FastAPI:
    app = FastAPI(title="新幣安機器人儀表板")

    @app.get("/", response_class=HTMLResponse)
    def dashboard():
        return _DASHBOARD_HTML

    @app.get("/api/status")
    def api_status():
        return bot.get_status_snapshot()

    @app.get("/api/trades")
    def api_trades():
        return bot.get_trade_history()

    @app.get("/api/trades.csv")
    def api_trades_csv():
        trades = bot.get_trade_history()
        buf = io.StringIO()
        fieldnames = [f.name for f in fields(TradeRecord)]
        writer = csv.DictWriter(buf, fieldnames=fieldnames)
        writer.writeheader()
        for t in trades:
            writer.writerow(t)
        # Content-Disposition 的 header value 只能是 latin-1,中文檔名不能直接塞進 filename=,
        # 要用 RFC 5987 的 filename*=UTF-8''<percent-encoded> 語法,並留一個 ASCII 檔名當後備。
        ts = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
        ascii_filename = f"trade_history_{ts}.csv"
        utf8_filename = quote(f"新幣安_交易紀錄_{ts}.csv")
        return Response(
            content=buf.getvalue(),
            media_type="text/csv",
            headers={
                "Content-Disposition": (
                    f'attachment; filename="{ascii_filename}"; '
                    f"filename*=UTF-8''{utf8_filename}"
                )
            },
        )

    @app.post("/api/close/{symbol}/{slot}")
    def api_close(symbol: str, slot: str):
        return bot.manual_close(symbol.upper(), slot.upper())

    @app.post("/api/open/{symbol}/{side}")
    def api_open(symbol: str, side: str):
        return bot.manual_open(symbol.upper(), side.upper())

    @app.post("/api/trading/pause")
    def api_pause():
        bot.pause_trading()
        return {"ok": True, "trading_enabled": bot.is_trading_enabled()}

    @app.post("/api/trading/resume")
    def api_resume():
        bot.resume_trading()
        return {"ok": True, "trading_enabled": bot.is_trading_enabled()}

    return app


