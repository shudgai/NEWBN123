# 紙交易帳戶 (Paper Trading) - 不呼叫真實下單 API,純本機模擬損益
# ---------------------------------------------------------------------------

@dataclass
class _PaperPosition:
    side: str = "NONE"
    quantity: float = 0.0
    entry_price: float = 0.0
    entry_time: str = ""
    entry_fee: float = 0.0
    best_price: float = 0.0  # 移動停利用:多單記錄進場以來的最高價,空單記錄最低價


@dataclass
class TradeRecord:
    symbol: str
    side: str
    entry_price: float
    exit_price: float
    quantity: float
    entry_time: str
    exit_time: str
    pnl: float  # 淨損益(已扣進出場兩邊手續費)
    fee: float  # 這筆交易的進出場手續費總和
    reason: str


class PaperAccount:
    """
    一個共用餘額的紙交易帳戶,底下每個交易對各自獨立持倉(如同一個帳戶同時開多個倉位)。
    開倉、平倉都會依 fee_pct 收取模擬手續費(單邊費率,跟幣安合約 Taker 費率一樣算在
    名目價值上),累積已實現損益(realized_pnl)已經是「扣掉手續費之後」的淨額。
    每筆平倉都會記錄一筆 TradeRecord 到 trade_history,供歷史紀錄查詢/下載使用。

    每個「倉位槽」用 (symbol, slot) 當 key。單向模式(HEDGE_MODE=false)一律只用
    slot="BOTH" 這一個槽,跟幣安帳戶本身在單向模式下 positionSide 固定回傳 "BOTH"
    是同一個概念,行為等同以前只有一個持倉欄位的版本。雙向模式(HEDGE_MODE=true)則是
    slot="LONG" 和 slot="SHORT" 各自獨立的兩個槽,可以同時各自持有多單、空單。
    """

    def __init__(self, starting_balance: float, symbols: List[str], fee_pct: float = 0.0):
        self.balance = starting_balance
        self.realized_pnl = 0.0
        self.total_fees = 0.0
        self.fee_pct = fee_pct
        self.positions: Dict[tuple, _PaperPosition] = {}
        self.trade_history: List[TradeRecord] = []

    def position(self, symbol: str, slot: str) -> _PaperPosition:
        key = (symbol, slot)
        if key not in self.positions:
            self.positions[key] = _PaperPosition()
        return self.positions[key]

    def unrealized_pnl(self, symbol: str, slot: str, current_price: float) -> float:
        p = self.position(symbol, slot)
        if p.side == "NONE":
            return 0.0
        diff = current_price - p.entry_price
        if p.side == "SHORT":
            diff = -diff
        return diff * p.quantity

    def open(self, symbol: str, slot: str, side: str, quantity: float, price: float) -> float:
        fee = quantity * price * self.fee_pct
        self.balance -= fee
        self.total_fees += fee
        p = self.position(symbol, slot)
        p.side = side
        p.quantity = quantity
        p.entry_price = price
        p.entry_time = datetime.now(timezone.utc).isoformat()
        p.entry_fee = fee
        p.best_price = price  # 移動停利的追蹤起點就是進場價
        return fee

    def update_trailing_peak(self, symbol: str, slot: str, price_high: float, price_low: float) -> float:
        """
        更新這個倉位「進場以來最有利的價格」(多單只會往上棘輪、空單只會往下棘輪,
        絕對不會往回退),回傳更新後的最佳價格。沒有倉位就回傳 0.0。
        """
        p = self.position(symbol, slot)
        if p.side == "NONE":
            return 0.0
        if p.side == "LONG":
            p.best_price = max(p.best_price, price_high)
        else:
            p.best_price = min(p.best_price, price_low)
        return p.best_price

    def close(self, symbol: str, slot: str, price: float, reason: str = "策略訊號") -> float:
        """平倉,回傳「扣掉本次平倉手續費之後」的淨損益(開倉手續費已經在 open() 時扣過)。"""
        p = self.position(symbol, slot)
        gross_pnl = self.unrealized_pnl(symbol, slot, price)
        exit_fee = p.quantity * price * self.fee_pct
        net_pnl = gross_pnl - exit_fee
        self.balance += net_pnl
        self.realized_pnl += net_pnl
        self.total_fees += exit_fee

        self.trade_history.append(TradeRecord(
            symbol=symbol, side=p.side, entry_price=p.entry_price, exit_price=price,
            quantity=p.quantity, entry_time=p.entry_time,
            exit_time=datetime.now(timezone.utc).isoformat(),
            pnl=net_pnl, fee=p.entry_fee + exit_fee, reason=reason,
        ))

        p.side = "NONE"
        p.quantity = 0.0
        p.entry_price = 0.0
        p.entry_time = ""
        p.entry_fee = 0.0
        p.best_price = 0.0
        return net_pnl

    def to_dict(self) -> dict:
        """序列化成可存成 JSON 的 dict,給 save_paper_state() 存檔用。"""
        return {
            "balance": self.balance,
            "realized_pnl": self.realized_pnl,
            "total_fees": self.total_fees,
            "positions": {
                f"{symbol}|{slot}": asdict(p) for (symbol, slot), p in self.positions.items()
            },
            "trade_history": [asdict(t) for t in self.trade_history],
        }

    @classmethod
    def from_dict(cls, data: dict, fee_pct: float) -> "PaperAccount":
        """load_paper_state() 用,從存檔內容還原一個 PaperAccount。"""
        account = cls(starting_balance=data.get("balance", 0.0), symbols=[], fee_pct=fee_pct)
        account.balance = data.get("balance", 0.0)
        account.realized_pnl = data.get("realized_pnl", 0.0)
        account.total_fees = data.get("total_fees", 0.0)
        for key, p_data in data.get("positions", {}).items():
            symbol, slot = key.split("|", 1)
            account.positions[(symbol, slot)] = _PaperPosition(**p_data)
        account.trade_history = [TradeRecord(**t) for t in data.get("trade_history", [])]
        return account


def save_paper_state(path: str, account: PaperAccount):
    """把紙交易帳戶目前的狀態寫成 JSON 檔,重啟時可以還原,不會每次都歸零重來。"""
    try:
        tmp_path = path + ".tmp"
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(account.to_dict(), f, ensure_ascii=False, indent=2)
        os.replace(tmp_path, path)  # 用 rename 取代寫入,避免寫到一半被中斷弄出半份壞檔
    except Exception as e:
        logger.error(f"❌ 儲存紙交易狀態失敗: {e}")


def load_paper_state(path: str, fee_pct: float) -> Optional[PaperAccount]:
    """讀取先前存檔的紙交易狀態;檔案不存在或讀取失敗都回傳 None,讓呼叫端改用全新帳戶。"""
    if not os.path.exists(path):
        return None
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        return PaperAccount.from_dict(data, fee_pct)
    except Exception as e:
        logger.error(f"❌ 讀取紙交易狀態存檔失敗,將改用全新帳戶: {e}")
        return None


