def main():
    config = Config.from_env()
    # 目前預設使用 MA7 轉折策略(谷底轉向上買入、高點轉向下賣出);
    # 換成 ManualSignalStrategy() 可回到只記錄市況、永遠 HOLD、不會下單的安全觀察模式,
    # 換成 EmaRsiCrossStrategy(adx_threshold=config.adx_threshold) 可切回均線交叉策略。
    strategy = MaTurnStrategy(ma_period=config.ma_period, confirm_bars=config.ma_confirm_bars)
    bot = BinanceFuturesBot(config, strategy)
    bot.setup()

    bot_thread = threading.Thread(target=bot.run, name="新幣安-bot-loop", daemon=True)
    bot_thread.start()

    app = create_app(bot)
    logger.info(f"🌐 儀表板啟動,請開啟瀏覽器: http://localhost:{config.web_port}")

    try:
        uvicorn.run(app, host="0.0.0.0", port=config.web_port, log_level="warning")
    finally:
        bot.stop()
        bot_thread.join(timeout=5)


if __name__ == "__main__":
    main()
