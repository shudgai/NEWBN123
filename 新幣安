class BinanceFuturesBot:
    def __init__(self, config: Config, strategy: Strategy):
        self.config = config
        self.strategy = strategy
        self._stop_event = threading.Event()
        # 保護所有會實際改變倉位狀態的動作(開倉/平倉),避免主迴圈執行緒跟網頁的
        # 「手動平倉」API 請求執行緒同時動到同一筆倉位,造成重複平倉之類的競態問題。
        # 用 RLock(可重入鎖)是因為 _process_slot() 在鎖已經拿到的情況下還會呼叫
        # is_trading_enabled(),它自己也要拿同一把鎖 - 一般的 Lock 在同一執行緒裡
        # 重複拿鎖會直接死鎖。
        self._trading_lock = threading.RLock()
        # 暫停交易只擋「開新倉」,現有倉位的止損/移動停利/策略平倉照常運作 -
        # 不會讓你暫停之後手上還握著沒有保護的倉位。
        self._trading_enabled = True

        self._status_lock = threading.Lock()
        self._status = {
            "started_at": None,
            "last_update": None,
            "balance": None,
            "symbols": {
                s: {"market": None, "positions": {}, "error": None}
                for s in config.symbols
            },
        }

        # 即使是紙交易模式,client 仍會用來讀取「公開」行情資料(K 線、現價、標記價格、
        # 交易對精度),這些端點不需要簽章驗證,即使沒有填 API Key 也能正常呼叫。
        #
        # 紙交易模式刻意「不」連測試網:紙交易從頭到尾都不會真的下單,不需要測試網的
        # 沙盒帳戶,而測試網的公開行情(尤其標記價格 K 線)常常是稀疏、不即時甚至整段
        # 時間卡住不動的假資料,拿來模擬損益會失真,跟真實市場的落差反而更大。所以
        # 這裡不能只是把 FUTURES_URL 這個字串改掉 - python-binance 內部的
        # _create_futures_api_uri() 是直接看 client.testnet 這個布林旗標來決定要不要
        # 導去測試網網址,不管 FUTURES_URL 被覆寫成什麼都一樣會被導去測試網,所以必須
        # 在建立 Client 的當下就不要傳 testnet=True 進去。BINANCE_TESTNET 只影響
        # PAPER_TRADING=false 之後真正下單的環境。
        use_testnet_client = config.testnet and not config.paper_trading
        self.client = Client(config.api_key, config.api_secret, testnet=use_testnet_client)

        self._qty_step: Dict[str, Decimal] = {}
        self._price_tick: Dict[str, Decimal] = {}

        self.paper_account: Optional[PaperAccount] = None
        loaded_from_state_file = False
        if config.paper_trading:
            loaded = None if config.reset_state else load_paper_state(config.state_file, config.fee_pct)
            if loaded is not None:
                self.paper_account = loaded
                loaded_from_state_file = True
            else:
                self.paper_account = PaperAccount(config.paper_starting_balance, config.symbols, config.fee_pct)

        if config.paper_trading:
            if loaded_from_state_file:
                mode = (
                    f"紙交易 (Paper Trading, 已從 {config.state_file} 還原狀態,"
                    f"餘額 {self.paper_account.balance:.4f} USDT、歷史交易 {len(self.paper_account.trade_history)} 筆,"
                    f"行情來源: 正式環境公開資料)"
                )
            else:
                mode = f"紙交易 (Paper Trading, 全新虛擬本金 {config.paper_starting_balance} USDT, 行情來源: 正式環境公開資料)"
            dry = "不會呼叫任何真實下單 API"
        else:
            mode = "測試網 (Testnet)" if config.testnet else "正式環境 (LIVE)"
            dry = "DRY_RUN 模擬模式(不會真的下單)" if config.dry_run else "真實下單模式"
        logger.info(f"⚡ 初始化完成 | 環境: {mode} | 下單模式: {dry} | 交易對: {', '.join(config.symbols)}")
        if not config.paper_trading and not config.testnet and not config.dry_run:
            logger.warning("⚠️ 目前為正式環境 + 真實下單模式,任何訊號都會動用真實資金,請確認策略已充分測試!")

    # -- 初始化 ------------------------------------------------------------

    def setup(self):
        """設定每個交易對的槓桿、保證金模式,並快取數量/價格精度。"""
        symbols = self.config.symbols

        if self.config.paper_trading:
            logger.info("📝 紙交易模式:略過槓桿/保證金/持倉模式 API 設定(無需連接真實帳戶)")
        else:
            try:
                self.client.futures_change_position_mode(dualSidePosition=self.config.hedge_mode)
                logger.info(f"✅ 帳戶持倉模式設定為 {'雙向持倉 (Hedge Mode)' if self.config.hedge_mode else '單向持倉'}")
            except BinanceAPIException as e:
                # -4059 = No need to change position side,代表已經是目標模式
                if getattr(e, "code", None) != -4059:
                    logger.warning(f"持倉模式設定提醒: {e}")

            for symbol in symbols:
                try:
                    self.client.futures_change_leverage(symbol=symbol, leverage=self.config.leverage)
                    logger.info(f"✅ 槓桿設定為 {self.config.leverage}x ({symbol})")
                except BinanceAPIException as e:
                    logger.warning(f"槓桿設定提醒(若已是相同倍數可忽略,{symbol}): {e}")

                try:
                    self.client.futures_change_margin_type(symbol=symbol, marginType=self.config.margin_type)
                    logger.info(f"✅ 保證金模式設定為 {self.config.margin_type} ({symbol})")
                except BinanceAPIException as e:
                    # -4046 = No need to change margin type,代表已經是目標模式
                    if getattr(e, "code", None) != -4046:
                        logger.warning(f"保證金模式設定提醒 ({symbol}): {e}")

        # 交易對精度是公開資料,一次呼叫拿回所有交易對,紙交易/真實交易都需要,且不需要驗證 API Key
        info = self.client.futures_exchange_info()
        info_by_symbol = {s["symbol"]: s for s in info["symbols"]}

        for symbol in symbols:
            symbol_info = info_by_symbol.get(symbol)
            if symbol_info is None:
                raise RuntimeError(f"在交易所找不到交易對 {symbol}")

            for f in symbol_info["filters"]:
                if f["filterType"] == "LOT_SIZE":
                    self._qty_step[symbol] = Decimal(f["stepSize"])
                elif f["filterType"] == "PRICE_FILTER":
                    self._price_tick[symbol] = Decimal(f["tickSize"])

            logger.info(
                f"✅ {symbol} 精度已快取 | 數量最小單位: {self._qty_step[symbol]} | "
                f"價格最小單位: {self._price_tick[symbol]}"
            )

    # -- 精度處理 ------------------------------------------------------------

    def _round_step(self, value: float, step: Decimal) -> float:
        d = Decimal(str(value))
        rounded = (d / step).to_integral_value(rounding=ROUND_DOWN) * step
        return float(rounded)

    def _round_qty(self, symbol: str, qty: float) -> float:
        step = self._qty_step.get(symbol)
        if step is None:
            return qty
        return self._round_step(qty, step)

    def _round_price(self, symbol: str, price: float) -> float:
        tick = self._price_tick.get(symbol)
        if tick is None:
            return price
        return self._round_step(price, tick)

    # -- 查詢 ------------------------------------------------------------

    def get_balance_usdt(self) -> float:
        if self.config.paper_trading:
            return self.paper_account.balance
        balances = self.client.futures_account_balance()
        for b in balances:
            if b["asset"] == "USDT":
                return float(b["balance"])
        return 0.0

    def get_market_snapshot(self, symbol: str) -> MarketSnapshot:
        ticker = self.client.futures_symbol_ticker(symbol=symbol)
        klines = self.client.futures_klines(
            symbol=symbol, interval=self.config.kline_interval, limit=100
        )
        return MarketSnapshot(symbol=symbol, price=float(ticker["price"]), klines=klines)

    def get_mark_price(self, symbol: str) -> float:
        return float(self.client.futures_mark_price(symbol=symbol)["markPrice"])

    def get_recent_mark_price_range(self, symbol: str, minutes: int = 5) -> tuple:
        """
        回傳最近 N 分鐘標記價格的 (最高, 最低)。真實下單時止損/移動停利是掛在交易所上的
        STOP_MARKET/TRAILING_STOP_MARKET(標記價格觸發),只要價格「曾經」碰到就會成交,
        不是只看某個時間點的價格;紙交易用輪詢模擬,如果只比對「這次輪詢當下」的價格,
        兩次輪詢之間的插針會被錯過,跟真實下單的行為會有落差。用最近幾分鐘的高低區間
        去檢查,才能貼近「價格曾經觸及」這件事,縮小紙交易與真實下單的差異。
        """
        klines = self.client.futures_mark_price_klines(symbol=symbol, interval="1m", limit=minutes)
        highs = [float(k[2]) for k in klines]
        lows = [float(k[3]) for k in klines]
        return max(highs), min(lows)

    def slot_for(self, side: str) -> str:
        """單向模式一律只有一個倉位槽("BOTH"),雙向模式才會分成獨立的 LONG / SHORT 槽。"""
        return side if self.config.hedge_mode else "BOTH"

    def get_position(self, symbol: str, slot: str, current_price: Optional[float] = None) -> PositionInfo:
        if self.config.paper_trading:
            p = self.paper_account.position(symbol, slot)
            upnl = self.paper_account.unrealized_pnl(symbol, slot, current_price) if current_price is not None else 0.0
            return PositionInfo(
                symbol=symbol, side=p.side, quantity=p.quantity,
                entry_price=p.entry_price, unrealized_pnl=upnl,
            )

        positions = self.client.futures_position_information(symbol=symbol)
        for p in positions:
            # 單向帳戶回傳的 positionSide 固定是 "BOTH";雙向帳戶則是 "LONG"/"SHORT",
            # 要挑對應的那一筆,不能兩種槽都拿同一筆資料。
            if p.get("positionSide", "BOTH") != slot:
                continue
            amt = float(p["positionAmt"])
            if amt != 0:
                side = "LONG" if amt > 0 else "SHORT"
                return PositionInfo(
                    symbol=symbol,
                    side=side,
                    quantity=abs(amt),
                    entry_price=float(p["entryPrice"]),
                    unrealized_pnl=float(p["unRealizedProfit"]),
                )
        return PositionInfo(symbol=symbol, side="NONE", quantity=0.0, entry_price=0.0, unrealized_pnl=0.0)

    # -- 下單 ------------------------------------------------------------

    def calc_quantity(self, symbol: str, price: float) -> float:
        """
        投入本金 = 帳戶餘額 * 風險比例,單純依帳戶餘額計算,金額會隨餘額成長/縮水同步
        增減。MAX_MARGIN_PER_TRADE_USDT > 0 時才會額外套用一個絕對金額上限(min);
        設成 0 就是關閉這個上限,完全交給風險比例決定,不再有固定金額天花板。
        下單數量 = 投入本金 * 槓桿 / 現價,再對齊交易所精度。
        """
        balance = self.get_balance_usdt()
        margin = balance * self.config.risk_pct_per_trade
        if self.config.max_margin_per_trade > 0:
            margin = min(margin, self.config.max_margin_per_trade)
        notional = margin * self.config.leverage
        raw_qty = notional / price
        qty = self._round_qty(symbol, raw_qty)
        if qty <= 0:
            logger.warning(
                f"⚠️ 計算出的下單數量為 0(餘額 {balance} USDT、風險比例 {self.config.risk_pct_per_trade}、"
                f"投入本金上限 {self.config.max_margin_per_trade or '未設定'} USDT、槓桿 {self.config.leverage}x),"
                f"請確認帳戶餘額或風險參數設定。"
            )
        return qty

    def _submit_order(self, **kwargs):
        if self.config.dry_run:
            logger.info(f"[DRY_RUN] 模擬下單,不會實際送出: {kwargs}")
            return None
        try:
            order = self.client.futures_create_order(**kwargs)
            logger.info(f"✅ 下單成功: {order}")
            return order
        except (BinanceAPIException, BinanceOrderException) as e:
            logger.error(f"❌ 下單失敗: {e}")
            return None

    def open_position(self, side: Signal, market: MarketSnapshot):
        symbol = market.symbol
        slot = self.slot_for(side.value)
        qty = self.calc_quantity(symbol, market.price)
        if qty <= 0:
            return

        logger.info(f"✨ [{symbol}][{slot}] 觸發 {side.value} 訊號,準備開倉 | 數量: {qty} | 參考價: {market.price}")

        if self.config.paper_trading:
            fee = self.paper_account.open(symbol, slot, side.value, qty, market.price)
            logger.info(
                f"[紙交易][{symbol}][{slot}] 已模擬開倉 {side.value} {qty} @ {market.price} | "
                f"手續費 -{fee:.4f} USDT | 帳戶餘額: {self.paper_account.balance:.4f} USDT"
            )
            self._save_state()
            return

        order_side = "BUY" if side == Signal.LONG else "SELL"
        entry_kwargs = dict(symbol=symbol, side=order_side, type="MARKET", quantity=qty)
        if self.config.hedge_mode:
            entry_kwargs["positionSide"] = slot
        self._submit_order(**entry_kwargs)

        if self.config.stop_loss_pct > 0:
            sl_side = "SELL" if side == Signal.LONG else "BUY"
            sl_price = market.price * (1 - self.config.stop_loss_pct) if side == Signal.LONG \
                else market.price * (1 + self.config.stop_loss_pct)
            sl_price = self._round_price(symbol, sl_price)
            logger.info(f"🛡️ [{symbol}][{slot}] 掛設止損: {sl_price}(以標記價格觸發,防止插針誤觸)")
            sl_kwargs = dict(
                symbol=symbol, side=sl_side, type="STOP_MARKET",
                stopPrice=sl_price, workingType="MARK_PRICE",
            )
            if self.config.hedge_mode:
                sl_kwargs["positionSide"] = slot  # 雙向模式不能同時帶 closePosition + positionSide 用 quantity 取代
                sl_kwargs["quantity"] = qty
            else:
                sl_kwargs["closePosition"] = True
            self._submit_order(**sl_kwargs)

        if self.config.trailing_stop_pct > 0:
            tp_side = "SELL" if side == Signal.LONG else "BUY"
            # 幣安的 callbackRate 是百分比數字(1 代表 1%),範圍 0.1~5,跟我們內部用小數
            # 表示比例(0.0025 代表 0.25%)不同,下單前要換算。
            callback_rate = round(self.config.trailing_stop_pct * 100, 1)
            # activationPrice:價格要先往有利方向跑到這裡,移動停利才會真的開始追蹤,
            # 不然一進場價格稍微逆向一點點就會被回調幅度打到,等於變成一個比 STOP_LOSS_PCT
            # 更緊的停損,搶在真正的停損之前出場——那就不是「停利」該做的事了。跟紙交易的
            # check_paper_trailing_stop() 用同一個門檻,確保兩邊行為一致。
            activation_price = market.price * (1 + self.config.trailing_stop_pct) if side == Signal.LONG \
                else market.price * (1 - self.config.trailing_stop_pct)
            activation_price = self._round_price(symbol, activation_price)
            logger.info(
                f"🎯 [{symbol}][{slot}] 掛設移動停利: callbackRate={callback_rate}% | "
                f"啟動價 {activation_price}(以標記價格啟動,防止插針誤觸)"
            )
            tp_kwargs = dict(
                symbol=symbol, side=tp_side, type="TRAILING_STOP_MARKET",
                callbackRate=callback_rate, activationPrice=activation_price, workingType="MARK_PRICE",
            )
            if self.config.hedge_mode:
                tp_kwargs["positionSide"] = slot
                tp_kwargs["quantity"] = qty
            else:
                tp_kwargs["closePosition"] = True
            self._submit_order(**tp_kwargs)

    def check_paper_stop_loss(self, position: PositionInfo,
                               price_high: float, price_low: float) -> Optional[str]:
        """
        檢查紙交易持倉是否觸及模擬止損,回傳 "STOP_LOSS" 或 None。
        用區間高/低點(而不是單一時間點的價格)判斷,盡量貼近真實下單「掛在交易所、價格
        曾經觸及就成交」的行為。
        """
        if not position.is_open or self.config.stop_loss_pct <= 0:
            return None
        entry = position.entry_price
        if position.side == "LONG":
            if price_low <= entry * (1 - self.config.stop_loss_pct):
                return "STOP_LOSS"
        else:  # SHORT
            if price_high >= entry * (1 + self.config.stop_loss_pct):
                return "STOP_LOSS"
        return None

    def check_paper_trailing_stop(self, symbol: str, slot: str, position: PositionInfo,
                                   price_high: float, price_low: float) -> Optional[str]:
        """
        更新這個倉位「進場以來最有利的價格」,並檢查是否從那個高點/低點回落超過
        TRAILING_STOP_PCT,回傳 "TRAILING_STOP" 或 None。多單只看最高價之後的回落,
        空單只看最低價之後的反彈,兩者都是「利潤縮水超過設定幅度就先落袋」的邏輯。

        必須先「啟動」才會真的去檢查觸發:價格要先往有利方向跑過 TRAILING_STOP_PCT
        (也就是先真的有獲利),移動停利才會開始追蹤。啟動之前只讓 STOP_LOSS_PCT 管,
        不然一筆進場就直接被套的交易,還沒到 1% 停損,反而先被這個「停利」用比停損
        更小的 0.25% 提早出場認賠 —— 那就違背了「停利」這個機制原本該做的事。
        """
        if not position.is_open or self.config.trailing_stop_pct <= 0:
            return None
        best_price = self.paper_account.update_trailing_peak(symbol, slot, price_high, price_low)
        if best_price <= 0:
            return None
        entry = position.entry_price
        if position.side == "LONG":
            activation_price = entry * (1 + self.config.trailing_stop_pct)
            if best_price < activation_price:
                return None  # 還沒真的獲利到位,先不啟動
            trail_stop_price = best_price * (1 - self.config.trailing_stop_pct)
            if price_low <= trail_stop_price:
                return "TRAILING_STOP"
        else:  # SHORT
            activation_price = entry * (1 - self.config.trailing_stop_pct)
            if best_price > activation_price:
                return None
            trail_stop_price = best_price * (1 + self.config.trailing_stop_pct)
            if price_high >= trail_stop_price:
                return "TRAILING_STOP"
        return None

    def close_position(self, position: PositionInfo, market: Optional[MarketSnapshot] = None,
                        reason: str = "策略訊號"):
        # position.is_open 是呼叫當下的快照;只信任這個旗標就好,不要在呼叫端另外快取
        # 舊的 position 物件重複呼叫這裡 - 這個判斷式就是唯一防止重複平倉的關卡。
        if not position.is_open:
            return
        symbol = position.symbol
        slot = self.slot_for(position.side)
        close_side = "SELL" if position.side == "LONG" else "BUY"

        logger.info(f"🛑 [{symbol}][{slot}] 觸發平倉 ({reason}),準備清空 {position.side} 倉位 (數量 {position.quantity})")

        if self.config.paper_trading:
            price = market.price if market is not None else position.entry_price
            pnl = self.paper_account.close(symbol, slot, price, reason=reason)
            logger.info(f"[紙交易][{symbol}][{slot}] 已模擬平倉 @ {price} | 本次損益: {pnl:+.4f} USDT | 帳戶餘額: {self.paper_account.balance:.4f} USDT")
            self._save_state()
            return

        if not self.config.dry_run and not self.config.hedge_mode:
            # 雙向模式下,同一個交易對的多單/空單各自獨立,不能整批撤單,
            # 否則會連另一個方向還在用的止損止盈單也一起撤掉。
            try:
                self.client.futures_cancel_all_open_orders(symbol=symbol)
            except BinanceAPIException as e:
                logger.warning(f"撤銷掛單提醒: {e}")

        close_kwargs = dict(symbol=symbol, side=close_side, type="MARKET", quantity=position.quantity)
        if self.config.hedge_mode:
            close_kwargs["positionSide"] = slot
        else:
            close_kwargs["reduceOnly"] = True
        self._submit_order(**close_kwargs)

    # -- 狀態(供網頁儀表板讀取) ---------------------------------------------

    def _now_iso(self) -> str:
        return datetime.now(timezone.utc).isoformat()

    def _update_symbol_status(self, symbol: str,
                               slot: Optional[str] = None,
                               market: Optional[MarketSnapshot] = None,
                               position: Optional[PositionInfo] = None,
                               last_signal: Optional[str] = None,
                               error: Optional[str] = None):
        """
        slot=None 只更新市況/錯誤,不動任何倉位槽的資料(例如例外處理路徑)。
        slot 有值時,更新的是 positions[slot] 這一個槽 - 單向模式一律是 "BOTH",
        雙向模式是 "LONG" 或 "SHORT",讓同一個 symbol 底下可以同時存在兩個獨立倉位的狀態。
        """
        with self._status_lock:
            entry = self._status["symbols"].setdefault(
                symbol, {"market": None, "positions": {}, "error": None}
            )
            if market is not None:
                entry["market"] = {"symbol": market.symbol, "price": market.price}
            if slot is not None:
                slot_entry = entry["positions"].setdefault(slot, {"position": None, "last_signal": None})
                if position is not None:
                    slot_entry["position"] = asdict(position)
                if last_signal is not None:
                    slot_entry["last_signal"] = last_signal
            entry["error"] = error

    def get_status_snapshot(self) -> dict:
        with self._status_lock:
            balance = self._status["balance"]
            last_update = self._status["last_update"]
            started_at = self._status["started_at"]
            symbols_status = {
                k: {"market": v["market"], "error": v["error"],
                    "positions": {sk: dict(sv) for sk, sv in v["positions"].items()}}
                for k, v in self._status["symbols"].items()
            }
        return {
            "symbol_list": self.config.symbols,
            "paper_trading": self.config.paper_trading,
            "testnet": self.config.testnet,
            "dry_run": self.config.dry_run,
            "leverage": self.config.leverage,
            "margin_type": self.config.margin_type,
            "kline_interval": self.config.kline_interval,
            "poll_interval_sec": self.config.poll_interval_sec,
            "hedge_mode": self.config.hedge_mode,
            "running": not self._stop_event.is_set(),
            "trading_enabled": self.is_trading_enabled(),
            "started_at": started_at,
            "last_update": last_update,
            "balance": balance,
            "realized_pnl": self.paper_account.realized_pnl if self.paper_account is not None else None,
            "total_fees": self.paper_account.total_fees if self.paper_account is not None else None,
            "symbols": symbols_status,
        }

    def get_trade_history(self) -> List[dict]:
        """回傳紙交易的歷史成交紀錄(list of dict);真實/測試網模式目前沒有本機交易紀錄,回傳空清單。"""
        if self.paper_account is None:
            return []
        return [asdict(t) for t in self.paper_account.trade_history]

    def _save_state(self):
        """把紙交易狀態存檔,讓下次重啟(不管是我改程式碼重啟、還是你自己重啟)都能接著跑,不會歸零。"""
        if self.paper_account is not None:
            save_paper_state(self.config.state_file, self.paper_account)

    def manual_close(self, symbol: str, slot: str) -> dict:
        """
        供網頁「手動平倉」按鈕呼叫:立即用目前市價平掉該倉位槽,不受策略邏輯影響。
        slot:單向模式一律傳 "BOTH";雙向模式傳 "LONG" 或 "SHORT",指定要平哪一邊。
        """
        if symbol not in self.config.symbols:
            return {"ok": False, "message": f"{symbol} 不在目前追蹤的交易對清單裡。"}

        with self._trading_lock:
            market = self.get_market_snapshot(symbol)
            position = self.get_position(symbol, slot, market.price)
            if not position.is_open:
                return {"ok": False, "message": f"{symbol} [{slot}] 目前沒有持倉,無需平倉。"}

            logger.info(f"🖱️ [{symbol}][{slot}] 收到手動平倉指令")
            self.close_position(position, market, reason="手動平倉")
            final_position = self.get_position(symbol, slot, market.price)

        self._update_symbol_status(symbol, slot=slot, market=market, position=final_position, last_signal="手動平倉")
        return {"ok": True, "message": f"{symbol} [{slot}] 已手動平倉。"}

    def manual_open(self, symbol: str, side: str) -> dict:
        """
        供網頁「手動開多/開空」按鈕呼叫:不管策略當下判斷什麼,直接依指定方向開倉。
        單向模式下如果已經持有反方向倉位,會擋下來(單向模式同一時間只能有一個方向);
        雙向模式下多單、空單各自獨立,只看該方向自己的槽有沒有已經開倉。
        """
        if symbol not in self.config.symbols:
            return {"ok": False, "message": f"{symbol} 不在目前追蹤的交易對清單裡。"}
        if side not in ("LONG", "SHORT"):
            return {"ok": False, "message": "方向必須是 LONG 或 SHORT。"}

        signal = Signal.LONG if side == "LONG" else Signal.SHORT
        slot = self.slot_for(side)

        with self._trading_lock:
            market = self.get_market_snapshot(symbol)
            position = self.get_position(symbol, slot, market.price)
            if position.is_open:
                return {"ok": False, "message": f"{symbol} [{slot}] 已經有 {position.side} 持倉,請先平倉再開新倉。"}

            logger.info(f"🖱️ [{symbol}][{slot}] 收到手動開倉指令 ({side})")
            self.open_position(signal, market)
            final_position = self.get_position(symbol, slot, market.price)

        self._update_symbol_status(symbol, slot=slot, market=market, position=final_position, last_signal=f"手動開倉({side})")
        return {"ok": True, "message": f"{symbol} [{slot}] 已手動開 {side}。"}

    # -- 主迴圈 ------------------------------------------------------------

    def stop(self):
        logger.info("收到停止訊號,機器人將於本輪結束後安全停止...")
        self._stop_event.set()

    def pause_trading(self):
        """暫停交易:不再開新倉,但現有倉位的止損/移動停利/策略平倉都照常運作。"""
        with self._trading_lock:
            self._trading_enabled = False
        logger.info("⏸️ 交易已暫停(不會再開新倉,現有倉位仍受止損/移動停利保護)")

    def resume_trading(self):
        with self._trading_lock:
            self._trading_enabled = True
        logger.info("▶️ 交易已恢復")

    def is_trading_enabled(self) -> bool:
        with self._trading_lock:
            return self._trading_enabled

    def _process_slot(self, symbol: str, slot: str, market: MarketSnapshot) -> tuple:
        """
        處理單一個倉位槽這一輪的「查詢持倉 -> 止損止盈檢查 -> 策略判斷 -> 開倉/平倉 ->
        再查一次最新狀態」,回傳 (final_position, last_signal_text)。呼叫端要負責包好
        _trading_lock,這裡不重複上鎖。

        單向模式只有一個槽("BOTH"),行為跟改雙向持倉之前完全一樣。雙向模式下,同一個
        策略邏輯會分別用「多單視角」「空單視角」對同一個 symbol 各呼叫一次 on_tick():
        策略本身完全不知道有幾個槽,只看得到「傳進來的這個槽現在是不是有倉位」。如果
        策略回傳的進場方向跟這個槽對不上(例如用空單視角呼叫,但市場其實是黃金交叉、
        策略判斷要開多),代表這個結果屬於「另一個槽」該處理的訊號,這裡直接忽略即可 -
        另一個槽會有自己的一次呼叫拿到正確結果,不會漏掉。
        """
        position = self.get_position(symbol, slot, market.price)

        # 紙交易的模擬止損/移動停利:每輪先檢查一次,用「標記價格」的區間高低點判斷(跟
        # 真實下單的 STOP_MARKET/TRAILING_STOP_MARKET 一樣用標記價格觸發,盡量縮小紙交易
        # 與真實下單之間的落差)。止損優先於移動停利檢查(保守,寧可提早停損也不要為了
        # 讓移動停利數字好看而拖遲)。若觸發就直接平倉並「重新查詢」position(而不是沿用
        # 手上這個已經過期的物件),確保稍後呼叫策略、甚至策略也回傳 CLOSE 時,
        # close_position() 看到的都是「已經沒有倉位」的最新狀態,不會對同一個倉位重複平倉。
        #
        # 移動停利的「追蹤最佳價格」每輪都要更新棘輪,即使這次沒觸發也一樣,所以只要
        # TRAILING_STOP_PCT > 0 且有倉位,就一定要呼叫 check_paper_trailing_stop() 讓它去
        # 更新棘輪 - 不能因為已經確定不會觸發就跳過呼叫。
        risk_exit_reason = None
        has_paper_stop_config = self.config.stop_loss_pct > 0 or self.config.trailing_stop_pct > 0
        if self.config.paper_trading and position.is_open and has_paper_stop_config:
            price_high, price_low = self.get_recent_mark_price_range(symbol)
            risk_exit_reason = self.check_paper_stop_loss(position, price_high, price_low)
            if risk_exit_reason is None:
                risk_exit_reason = self.check_paper_trailing_stop(symbol, slot, position, price_high, price_low)
            if risk_exit_reason is not None:
                mark_price = self.get_mark_price(symbol)
                close_market = MarketSnapshot(symbol=symbol, price=mark_price, klines=[])
                self.close_position(position, close_market, reason=risk_exit_reason)
                position = self.get_position(symbol, slot, market.price)

        signal = self.strategy.on_tick(market, position)

        if risk_exit_reason is not None:
            pass  # 本輪已經因為止損/止盈平倉,不再套用策略訊號
        elif signal == Signal.HOLD:
            pass
        elif signal == Signal.CLOSE:
            if position.is_open:
                self.close_position(position, market)
        elif signal in (Signal.LONG, Signal.SHORT):
            target_slot = self.slot_for(signal.value)
            if target_slot != slot:
                pass  # 這個進場訊號屬於另一個槽,不是這次呼叫該處理的
            elif not self.is_trading_enabled():
                logger.info(f"[{symbol}][{slot}] 交易已暫停,忽略新的 {signal.value} 進場訊號")
            elif position.is_open:
                logger.info(f"[{symbol}][{slot}] 已有 {position.side} 持倉,忽略新的 {signal.value} 訊號")
            else:
                self.open_position(signal, market)

        final_position = self.get_position(symbol, slot, market.price)
        return final_position, (risk_exit_reason or signal.value)

    def run(self):
        self._stop_event.clear()
        with self._status_lock:
            self._status["started_at"] = self._now_iso()

        mode_desc = "雙向持倉(多空可同時進場)" if self.config.hedge_mode else "單向持倉"
        logger.info(f"🤖 機器人開始運行 | 交易對: {', '.join(self.config.symbols)} | "
                    f"週期: {self.config.kline_interval} | 輪詢間隔: {self.config.poll_interval_sec}s | "
                    f"{mode_desc}")

        slots = ("LONG", "SHORT") if self.config.hedge_mode else ("BOTH",)

        while not self._stop_event.is_set():
            for symbol in self.config.symbols:
                try:
                    market = self.get_market_snapshot(symbol)

                    # 這個 symbol 這一輪、所有倉位槽的「查詢持倉 -> 判斷 -> 開倉/平倉」都用
                    # _trading_lock 包起來,避免跟網頁「手動平倉/手動開倉」API 請求同時動到
                    # 同一筆倉位(例如剛好同時各自平倉一次,造成重複平倉)。
                    with self._trading_lock:
                        results = [(slot, *self._process_slot(symbol, slot, market)) for slot in slots]

                    for slot, final_position, signal_text in results:
                        self._update_symbol_status(
                            symbol, slot=slot, market=market,
                            position=final_position, last_signal=signal_text,
                        )

                except BinanceAPIException as e:
                    logger.error(f"❌ [{symbol}] Binance API 錯誤: {e}")
                    self._update_symbol_status(symbol, error=str(e))
                except Exception as e:
                    logger.error(f"❌ [{symbol}] 主迴圈發生未預期錯誤: {e}", exc_info=True)
                    self._update_symbol_status(symbol, error=str(e))

            # 餘額放在這一輪所有幣種的開倉/平倉動作都做完後才查詢,理由跟上面
            # final_position 一樣:避免這一輪剛扣的手續費/損益還沒反映在畫面上。
            try:
                balance = self.get_balance_usdt()
                with self._status_lock:
                    self._status["balance"] = balance
                    self._status["last_update"] = self._now_iso()
            except Exception as e:
                logger.error(f"❌ 查詢帳戶餘額失敗: {e}")

            # 每輪都存一次檔,不只是開倉/平倉當下 - 這樣移動停利追蹤到的「最佳價格」
            # 這種持倉期間持續更新、但不涉及開平倉動作的狀態,也不會因為重啟而遺失。
            self._save_state()

            self._stop_event.wait(self.config.poll_interval_sec)

        logger.info("機器人已停止。")
        self._save_state()


