class Signal(Enum):
    LONG = "LONG"
    SHORT = "SHORT"
    CLOSE = "CLOSE"
    HOLD = "HOLD"


@dataclass
class MarketSnapshot:
    symbol: str
    price: float
    klines: list  # Binance futures_klines() 原始回傳資料


@dataclass
class PositionInfo:
    symbol: str
    side: str  # "LONG" / "SHORT" / "NONE"
    quantity: float
    entry_price: float
    unrealized_pnl: float

    @property
    def is_open(self) -> bool:
        return self.side != "NONE"


class Strategy(ABC):
    """所有自訂策略請繼承此類別,實作 on_tick() 回傳交易訊號。"""

    @abstractmethod
    def on_tick(self, market: MarketSnapshot, position: PositionInfo) -> Signal:
        raise NotImplementedError


class ManualSignalStrategy(Strategy):
    """
    預設範例策略:永遠回傳 HOLD,只記錄目前市況與持倉,不會觸發任何下單。
    用來驗證資料流(行情、持倉查詢)是否正常。實際交易邏輯請另外繼承 Strategy 實作,
    例如加入均線、RSI 等技術指標判斷後回傳 Signal.LONG / SHORT / CLOSE。
    """

    def on_tick(self, market: MarketSnapshot, position: PositionInfo) -> Signal:
        logger.info(
            f"[策略] {market.symbol} 現價 {market.price} | "
            f"持倉 {position.side} 數量 {position.quantity} "
            f"(未實現損益 {position.unrealized_pnl})"
        )
        return Signal.HOLD


def _ema(values: list, period: int) -> list:
    """指數移動平均線 (EMA),回傳長度與 values 相同的序列。"""
    if not values:
        return []
    k = 2 / (period + 1)
    result = [values[0]]
    for v in values[1:]:
        result.append(v * k + result[-1] * (1 - k))
    return result


def _rsi(values: list, period: int) -> list:
    """RSI 相對強弱指標,回傳長度與 values 相同的序列;資料不足的部分補 50(中性值)。"""
    n = len(values)
    result = [50.0] * n
    if n < period + 1:
        return result

    gains = [0.0] * n
    losses = [0.0] * n
    for i in range(1, n):
        change = values[i] - values[i - 1]
        gains[i] = max(change, 0.0)
        losses[i] = max(-change, 0.0)

    for i in range(period, n):
        avg_gain = sum(gains[i - period + 1: i + 1]) / period
        avg_loss = sum(losses[i - period + 1: i + 1]) / period
        if avg_loss == 0:
            result[i] = 100.0
        else:
            rs = avg_gain / avg_loss
            result[i] = 100 - (100 / (1 + rs))
    return result


def _wilder_smooth(values: list, period: int) -> list:
    """Wilder 平滑(ADX/ATR 慣用的平滑法,alpha = 1/period,跟 _ema() 的 2/(period+1) 不同)。"""
    n = len(values)
    if n == 0:
        return []
    alpha = 1 / period
    result = [values[0]]
    for v in values[1:]:
        result.append(v * alpha + result[-1] * (1 - alpha))
    return result


def _adx(highs: list, lows: list, closes: list, period: int = 14) -> list:
    """
    ADX 平均趨向指標,回傳長度與輸入相同的序列;資料不足補 0(視為「沒有趨勢」,
    這樣濾網預設是保守的 - 資料不夠就不進場,而不是誤放行)。
    數值愈高代表趨勢愈強(不分方向),用來過濾盤整時容易出現的均線假交叉訊號。
    """
    n = len(closes)
    result = [0.0] * n
    if n < period + 2:
        return result

    tr = [0.0] * n
    plus_dm = [0.0] * n
    minus_dm = [0.0] * n
    for i in range(1, n):
        high_low = highs[i] - lows[i]
        high_close = abs(highs[i] - closes[i - 1])
        low_close = abs(lows[i] - closes[i - 1])
        tr[i] = max(high_low, high_close, low_close)

        up_move = highs[i] - highs[i - 1]
        down_move = lows[i - 1] - lows[i]
        plus_dm[i] = up_move if (up_move > down_move and up_move > 0) else 0.0
        minus_dm[i] = down_move if (down_move > up_move and down_move > 0) else 0.0

    atr = _wilder_smooth(tr, period)
    plus_dm_smooth = _wilder_smooth(plus_dm, period)
    minus_dm_smooth = _wilder_smooth(minus_dm, period)

    dx = [0.0] * n
    for i in range(n):
        plus_di = 100 * plus_dm_smooth[i] / atr[i] if atr[i] > 0 else 0.0
        minus_di = 100 * minus_dm_smooth[i] / atr[i] if atr[i] > 0 else 0.0
        di_sum = plus_di + minus_di
        dx[i] = 100 * abs(plus_di - minus_di) / di_sum if di_sum > 0 else 0.0

    return _wilder_smooth(dx, period)


class EmaRsiCrossStrategy(Strategy):
    """
    EMA 快慢線交叉 + RSI 確認 + ADX 趨勢濾網:
      - 快線由下往上穿越慢線(黃金交叉)+ RSI > rsi_buy_threshold + ADX > adx_threshold -> 做多
      - 快線由上往下穿越慢線(死亡交叉)+ RSI < rsi_sell_threshold + ADX > adx_threshold -> 做空
      - 有多單時遇死亡交叉平倉;有空單時遇黃金交叉平倉(出場不看 ADX,隨時都能出場)

    ADX 是趨勢強度指標,數值低代表盤整、均線很容易出現沒有意義的假交叉。只有 ADX
    高於門檻(代表真的有趨勢)才允許進場,用來過濾掉盤整時的雜訊訊號。

    判斷一律使用「已收盤」的K棒(倒數第二根),避免用尚未收盤、仍在變動的最新
    K棒判斷交叉,導致訊號在收盤前反覆出現又消失。
    """

    def __init__(self, ema_fast: int = 9, ema_slow: int = 21, rsi_period: int = 14,
                 rsi_buy_threshold: float = 50.0, rsi_sell_threshold: float = 50.0,
                 adx_period: int = 14, adx_threshold: float = 20.0):
        self.ema_fast = ema_fast
        self.ema_slow = ema_slow
        self.rsi_period = rsi_period
        self.rsi_buy_threshold = rsi_buy_threshold
        self.rsi_sell_threshold = rsi_sell_threshold
        self.adx_period = adx_period
        self.adx_threshold = adx_threshold

    def on_tick(self, market: MarketSnapshot, position: PositionInfo) -> Signal:
        # Binance futures_klines 欄位: [開盤時間, 開, 高, 低, 收, 量, 收盤時間, ...]
        highs = [float(k[2]) for k in market.klines]
        lows = [float(k[3]) for k in market.klines]
        closes = [float(k[4]) for k in market.klines]

        min_len = max(self.ema_slow, self.rsi_period, self.adx_period) + 3
        if len(closes) < min_len:
            logger.info(f"[策略] K 線資料不足({len(closes)}/{min_len}),暫時觀望")
            return Signal.HOLD

        ema_fast = _ema(closes, self.ema_fast)
        ema_slow = _ema(closes, self.ema_slow)
        rsi = _rsi(closes, self.rsi_period)
        adx = _adx(highs, lows, closes, self.adx_period)

        # -1 是尚未收盤的最新K棒,-2 是最後一根已收盤K棒,-3 是再前一根已收盤K棒
        golden_cross = ema_fast[-3] <= ema_slow[-3] and ema_fast[-2] > ema_slow[-2]
        death_cross = ema_fast[-3] >= ema_slow[-3] and ema_fast[-2] < ema_slow[-2]
        last_rsi = rsi[-2]
        last_adx = adx[-2]
        trending = last_adx > self.adx_threshold

        logger.info(
            f"[策略] {market.symbol} 現價 {market.price} | EMA{self.ema_fast}/{self.ema_slow}: "
            f"{ema_fast[-2]:.2f}/{ema_slow[-2]:.2f} | RSI{self.rsi_period}: {last_rsi:.1f} | "
            f"ADX{self.adx_period}: {last_adx:.1f} | 持倉 {position.side} 數量 {position.quantity}"
        )

        if not position.is_open:
            if golden_cross and last_rsi > self.rsi_buy_threshold and trending:
                logger.info(
                    f"🟢 黃金交叉 + RSI {last_rsi:.1f} > {self.rsi_buy_threshold} + "
                    f"ADX {last_adx:.1f} > {self.adx_threshold},觸發做多訊號"
                )
                return Signal.LONG
            if death_cross and last_rsi < self.rsi_sell_threshold and trending:
                logger.info(
                    f"🔴 死亡交叉 + RSI {last_rsi:.1f} < {self.rsi_sell_threshold} + "
                    f"ADX {last_adx:.1f} > {self.adx_threshold},觸發做空訊號"
                )
                return Signal.SHORT
        else:
            if position.side == "LONG" and death_cross:
                logger.info("📉 持多單遇死亡交叉,觸發平倉訊號")
                return Signal.CLOSE
            if position.side == "SHORT" and golden_cross:
                logger.info("📈 持空單遇黃金交叉,觸發平倉訊號")
                return Signal.CLOSE

        return Signal.HOLD


def _bollinger_bands(values: list, period: int, num_std: float):
    """布林通道:回傳 (中軌 SMA, 上軌, 下軌) 三條長度與 values 相同的序列。"""
    n = len(values)
    sma = [0.0] * n
    upper = [0.0] * n
    lower = [0.0] * n
    for i in range(n):
        if i < period - 1:
            sma[i] = values[i]
            upper[i] = values[i]
            lower[i] = values[i]
            continue
        window = values[i - period + 1: i + 1]
        mean = sum(window) / period
        variance = sum((x - mean) ** 2 for x in window) / period
        std = variance ** 0.5
        sma[i] = mean
        upper[i] = mean + num_std * std
        lower[i] = mean - num_std * std
    return sma, upper, lower


class BollingerRsiReversionStrategy(Strategy):
    """
    布林通道 + RSI 均值回歸策略,邏輯跟 EmaRsiCrossStrategy 完全相反:
    不是「跟著動能追進去」,而是「在價格衝過頭時反著做,賭它會拉回平均值」。
      - 收盤價跌破下軌 + RSI < rsi_oversold(超賣)-> 做多,賭反彈
      - 收盤價漲破上軌 + RSI > rsi_overbought(超買)-> 做空,賭回落
      - 價格回到中軌(布林通道的移動平均線)就出場,不等到真的反向超買/超賣

    適合盤整、區間震盪的行情;如果市場其實是在一段趨勢中,這個策略會一直在
    「越噴越買、越跌越空」,虧損可能持續擴大 - 這也是為什麼框架本身的
    STOP_LOSS_PCT/TRAILING_STOP_PCT 這種跟策略邏輯無關的保底防護仍然很重要。

    判斷一律使用「已收盤」的K棒(倒數第二根),理由跟 EmaRsiCrossStrategy 一樣。
    """

    def __init__(self, bb_period: int = 20, bb_std: float = 2.0, rsi_period: int = 14,
                 rsi_oversold: float = 30.0, rsi_overbought: float = 70.0):
        self.bb_period = bb_period
        self.bb_std = bb_std
        self.rsi_period = rsi_period
        self.rsi_oversold = rsi_oversold
        self.rsi_overbought = rsi_overbought

    def on_tick(self, market: MarketSnapshot, position: PositionInfo) -> Signal:
        closes = [float(k[4]) for k in market.klines]

        min_len = max(self.bb_period, self.rsi_period) + 3
        if len(closes) < min_len:
            logger.info(f"[策略] K 線資料不足({len(closes)}/{min_len}),暫時觀望")
            return Signal.HOLD

        sma, upper, lower = _bollinger_bands(closes, self.bb_period, self.bb_std)
        rsi = _rsi(closes, self.rsi_period)

        # -1 是尚未收盤的最新K棒,-2 是最後一根已收盤K棒
        last_close = closes[-2]
        last_sma = sma[-2]
        last_upper = upper[-2]
        last_lower = lower[-2]
        last_rsi = rsi[-2]

        logger.info(
            f"[策略] {market.symbol} 現價 {market.price} | 布林{self.bb_period}({self.bb_std}σ): "
            f"下軌 {last_lower:.2f} / 中軌 {last_sma:.2f} / 上軌 {last_upper:.2f} | "
            f"收盤 {last_close:.2f} | RSI{self.rsi_period}: {last_rsi:.1f} | "
            f"持倉 {position.side} 數量 {position.quantity}"
        )

        if not position.is_open:
            if last_close <= last_lower and last_rsi < self.rsi_oversold:
                logger.info(f"🟢 收盤價跌破下軌 + RSI {last_rsi:.1f} < {self.rsi_oversold}(超賣),觸發做多訊號")
                return Signal.LONG
            if last_close >= last_upper and last_rsi > self.rsi_overbought:
                logger.info(f"🔴 收盤價漲破上軌 + RSI {last_rsi:.1f} > {self.rsi_overbought}(超買),觸發做空訊號")
                return Signal.SHORT
        else:
            if position.side == "LONG" and last_close >= last_sma:
                logger.info("📈 多單價格已回到中軌,觸發平倉訊號(均值回歸完成)")
                return Signal.CLOSE
            if position.side == "SHORT" and last_close <= last_sma:
                logger.info("📉 空單價格已回到中軌,觸發平倉訊號(均值回歸完成)")
                return Signal.CLOSE

        return Signal.HOLD


def _sma(values: list, period: int) -> list:
    """簡單移動平均線 (SMA),回傳長度與 values 相同的序列;資料不足的前段用目前為止的平均頂替。"""
    n = len(values)
    result = [0.0] * n
    for i in range(n):
        if i < period - 1:
            result[i] = sum(values[:i + 1]) / (i + 1)
        else:
            result[i] = sum(values[i - period + 1:i + 1]) / period
    return result


class MaTurnStrategy(Strategy):
    """
    MA(預設 7 期)轉折策略:只看均線本身的走向有沒有轉彎,不看價格本身、不搭配其他指標。
      - MA 從下降轉為上升(谷底反轉,V 型底)-> 做多
      - MA 從上升轉為下降(高點反轉,倒 V 型頂)-> 做空
      - 持多單時遇到高點反轉(倒V頂)-> 平倉;持空單時遇到谷底反轉(V型底)-> 平倉

    「轉彎」需要連續 confirm_bars 根(預設 2 根)都確認同一個新方向才算數,不是
    一根就觸發 - 盤整時 MA 常常單根小幅上下擺動,只看一根很容易把雜訊誤判成轉折;
    要求連續多根同向,才比較接近「真的轉彎」而不是原地盤整的擺動。

    判斷一律使用「已收盤」的K棒(-1 是尚未收盤、仍在變動的最新K棒,不採用),
    避免用還沒收盤的K棒導致訊號在收盤前反覆出現又消失。
    """

    def __init__(self, ma_period: int = 7, confirm_bars: int = 2):
        self.ma_period = ma_period
        self.confirm_bars = max(1, confirm_bars)

    def on_tick(self, market: MarketSnapshot, position: PositionInfo) -> Signal:
        closes = [float(k[4]) for k in market.klines]

        min_len = self.ma_period + self.confirm_bars + 4
        if len(closes) < min_len:
            logger.info(f"[策略] K 線資料不足({len(closes)}/{min_len}),暫時觀望")
            return Signal.HOLD

        ma = _sma(closes, self.ma_period)

        # points 是最後 confirm_bars+2 個「已收盤」的 MA 值(由舊到新),
        # points[-1] 對應 ma[-2](最後一根已收盤K棒)。
        # points[0] -> points[1] 是「轉折前」的參考步,points[1:] 之間的
        # confirm_bars 個連續步伐,要全部同方向,才算「確認轉彎」。
        points = ma[-(self.confirm_bars + 3):-1]
        ref, before_turn = points[0], points[1]
        confirm_points = points[1:]

        # "之前的走勢"用 <=/>= 讓「持平」算進原本的趨勢裡,不要求嚴格遞增/遞減 -
        # 否則遇到轉折點剛好卡在一個持平的點,嚴格不等式會把這個轉折判斷漏掉。
        was_falling = before_turn <= ref
        was_rising = before_turn >= ref
        now_confirmed_rising = all(
            confirm_points[i] > confirm_points[i - 1] for i in range(1, len(confirm_points))
        )
        now_confirmed_falling = all(
            confirm_points[i] < confirm_points[i - 1] for i in range(1, len(confirm_points))
        )

        trough_turn_up = was_falling and now_confirmed_rising
        peak_turn_down = was_rising and now_confirmed_falling

        logger.info(
            f"[策略] {market.symbol} 現價 {market.price} | MA{self.ma_period} 最近{len(points)}點: "
            f"{' -> '.join(f'{p:.2f}' for p in points)} | 持倉 {position.side} 數量 {position.quantity}"
        )

        if not position.is_open:
            if trough_turn_up:
                logger.info(f"🟢 MA{self.ma_period} 谷底轉向上(已連續{self.confirm_bars}根確認),觸發做多訊號")
                return Signal.LONG
            if peak_turn_down:
                logger.info(f"🔴 MA{self.ma_period} 高點轉向下(已連續{self.confirm_bars}根確認),觸發做空訊號")
                return Signal.SHORT
        else:
            if position.side == "LONG" and peak_turn_down:
                logger.info(f"📉 持多單遇 MA{self.ma_period} 高點轉向下(已連續{self.confirm_bars}根確認),觸發平倉訊號")
                return Signal.CLOSE
            if position.side == "SHORT" and trough_turn_up:
                logger.info(f"📈 持空單遇 MA{self.ma_period} 谷底轉向上(已連續{self.confirm_bars}根確認),觸發平倉訊號")
                return Signal.CLOSE

        return Signal.HOLD


