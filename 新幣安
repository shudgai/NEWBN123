      <div class="card"><div class="label">帳戶餘額 (USDT)</div><div class="value">${s.balance ?? '-'}</div></div>
      <div class="card"><div class="label">總已實現損益 (USDT)</div><div class="value ${rpnlClass}">${rpnl ?? '-'}</div></div>
      <div class="card"><div class="label">槓桿 / 保證金模式</div><div class="value">${s.leverage}x / ${s.margin_type}</div></div>
      <div class="card"><div class="label">K 線週期 / 輪詢間隔</div><div class="value">${s.kline_interval} / ${s.poll_interval_sec}s</div></div>
      <div class="card"><div class="label">追蹤幣種數</div><div class="value">${(s.symbol_list || []).length}</div></div>
      <div class="card"><div class="label">啟動時間</div><div class="value" style="font-size:.9rem">${s.started_at ?? '-'}</div></div>
    `;

    const symbolsBox = document.getElementById('symbols');
    symbolsBox.innerHTML = (s.symbol_list || []).map(sym => {
      const d = (s.symbols && s.symbols[sym]) || {};
      const market = d.market || {};
      const errHtml = d.error ? `<div class="symbol-error">⚠️ ${d.error}</div>` : '';
      const positions = d.positions || {};
      const slotKeys = s.hedge_mode ? ['LONG', 'SHORT'] : ['BOTH'];

      const slotBlocks = slotKeys.map(slot => {
        const slotData = positions[slot] || {};
        const pos = slotData.position || {};
        const isOpen = pos.side && pos.side !== 'NONE';
        const pnl = pos.unrealized_pnl;
        const pnlClass = pnl > 0 ? 'pnl-pos' : (pnl < 0 ? 'pnl-neg' : '');
        // 未實現損益的百分比是相對於這筆倉位「投入的本金(保證金)」算的報酬率(ROE),
        // 不是價格漲跌幅本身 - 名目價值 / 槓桿 = 本金,槓桿愈高同樣價格變動的 % 會愈大。
        const notional = (pos.quantity && pos.entry_price) ? pos.quantity * pos.entry_price : 0;
        const margin = (notional && s.leverage) ? notional / s.leverage : 0;
        const pnlPctText = (margin > 0 && pnl !== undefined && pnl !== null)
          ? ` (${pnl >= 0 ? '+' : ''}${(pnl / margin * 100).toFixed(2)}%)` : '';
        const pnlText = (pnl ?? '-') + (pnl != null ? pnlPctText : '');
        const marginText = margin > 0 ? margin.toFixed(2) : '-';
        const notionalText = notional > 0 ? notional.toFixed(2) : '-';

        // 單向模式("BOTH" 槽)可以選多或空;雙向模式每個槽只對應自己的方向。
        const openSides = slot === 'LONG' ? ['LONG'] : slot === 'SHORT' ? ['SHORT'] : ['LONG', 'SHORT'];
        const actionBtns = isOpen
